{
  "name": "galactic-sap-cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.4"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "test": "cds test ",
    "watch-cosmic-fiori": "cds watch --open cosmicfiori/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "Alice": {
            "password": "Alice",
            "roles": [
              "authenticated-user"
            ],
            "attr": {
              "email": "alice@galactic.example"
            }
          },
          "Bob": {
            "password": "Bob",
            "roles": [
              "authenticated-user"
            ],
            "attr": {
              "email": "bob@galactic.example"
            }
          },
          "Charlie": {
            "password": "Charlie",
            "roles": [
              "authenticated-user"
            ],
            "attr": {
              "email": "charlie@galactic.example"
            }
          },
          "*": false
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/cosmic-fiori"
  ]
}
